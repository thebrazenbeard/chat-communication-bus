{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/chat-communication-bus/projects/selfimage/blender-relay/schema/request.schema.json",
  "title": "Vera Blender Relay Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "request_id", "operation", "args", "created_at"],
  "properties": {
    "version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "operation": {
      "type": "string",
      "enum": [
        "ping",
        "addon_info",
        "scene_info",
        "object_info",
        "world_state",
        "viewport_capture",
        "mesh_audit",
        "scene_audit_v1",
        "import_exact_cc0",
        "render_five_view_cc0",
        "save_blend_copy",
        "export_scene_glb"
      ]
    },
    "args": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
