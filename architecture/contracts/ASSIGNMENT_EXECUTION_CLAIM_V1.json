    "runtime_instance_field": "node_id",
    "durable_identity_is_not_runtime_identity": true,
    "execution_claim_is_not_authority": true
  },
  "current_claim": {
    "one_current_claim_per_assignment": true,
    "fields": [
      "assignment_id",
      "assignee_identity_id",
      "node_id",
      "fence_token",
      "bound_assignment_event_id",
      "lease_expires_at",
      "last_operation_id",
      "updated_at"
    ]
  },
  "audit": {
